# Copy to .env and adjust. Defaults match docker-compose.yml.
NODE_ENV=development

DATABASE_URL=postgres://bodhi:bodhi@localhost:5432/bodhi
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=bodhi

SMTP_HOST=localhost
SMTP_PORT=1025

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# D-27: server-authoritative timer behaviour on candidate disconnect.
TIMER_DISCONNECT_POLICY=keep-running
TIMER_RECONNECT_GRACE_SECONDS=45

# D-09: gateway behind the payment adapter. CCAvenue retained for legacy parity.
PAYMENT_GATEWAY=ccavenue

# BR-12: attempt lock threshold.
MAX_ATTEMPTS_PER_ASSESSMENT=3
